rules_version = '2';

// ArmorTex platform — Firestore security rules (phase 0).
//
// Access model:
//   staff/{email}  — allowlist of people who can sign in. role: owner | admin | pm.
//   Everything else is staff-only for now. Customer-portal rules arrive in phase 4
//   (records carry customerVisible + customerId; customers read only their own).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function staffPath() {
      return /databases/$(database)/documents/staff/$(email());
    }
    function isStaff() {
      return signedIn() && exists(staffPath());
    }
    function role() {
      return get(staffPath()).data.role;
    }
    function isAdmin() {
      return isStaff() && role() in ['owner', 'admin'];
    }
    function isOwner() {
      return isStaff() && role() == 'owner';
    }
    function validStaffDoc() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'role'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.role in ['owner', 'admin', 'pm'];
    }

    // ---- team allowlist ----
    match /staff/{staffEmail} {
      allow read: if isStaff();
      // Admins add/edit pm + admin; only an owner can grant owner.
      allow create, update: if isAdmin() && validStaffDoc()
                            && (request.resource.data.role != 'owner' || isOwner());
      // Nobody removes themselves; owners can only be removed by an owner.
      allow delete: if isAdmin() && staffEmail != email()
                    && (resource.data.role != 'owner' || isOwner());
    }

    // ---- business data: staff only (phase 1+) ----
    match /customers/{id}    { allow read, write: if isStaff(); }
    match /jobs/{id}         { allow read, write: if isStaff(); }
    match /appointments/{id} { allow read, write: if isStaff(); }
    match /activities/{id}   { allow read, write: if isStaff(); }
    match /settings/{id}     { allow read: if isStaff(); allow write: if isAdmin(); }

    // ---- default deny ----
    match /{document=**} { allow read, write: if false; }
  }
}
